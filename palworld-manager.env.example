# Palworld Manager 環境変数サンプル
# このファイルを /etc/palworld-manager.env にコピーして値を設定してください

# 環境識別: staging または production
PAL_ENV=staging

# Palworld サーバーのホスト・ポート
PAL_HOST=localhost
PAL_PORT=8212

# PalWorldSettings.ini の AdminPassword の値
PAL_ADMIN_PASSWORD=admin

# Web UI のリッスンポート
APP_PORT=8080

# Palworld の systemd サービス名（起動・停止・再起動・ログ取得に使用）
# 実機のサービス名に合わせてください（例では palserver）
PAL_SERVICE_NAME=palserver

# PalWorldSettings.ini のフルパス
PAL_SETTINGS_INI=/home/palworld-user/PalServer/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini

# スケジュールの解釈・表示に使うタイムゾーン
SCHEDULE_TIMEZONE=Asia/Tokyo

# Discord Webhook URL: メモリ監視（80% Warning / 90% Critical / 回復通知）
# 未設定ならメモリ監視通知は無効
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Discord Webhook URL: Manager の起動・停止通知（🟢 起動 / 🔴 停止）
# 未設定なら起動/停止通知は無効
# DISCORD_LIFECYCLE_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
